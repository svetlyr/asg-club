BOT_TOKEN=<your-bot-token>

# SQLite database file (created automatically). Defaults to ./orders.db
DATABASE_PATH=./orders.db

# Not actual IDs, just examples
OWNER_CHAT_ID=123456789
DESIGNER_CHAT_ID=987654321
PRINTER_CHAT_ID=192837465
FACTORY_CHAT_ID=214586752

# Resend (https://resend.com) — MAIL_FROM must be on a verified domain,
# or use onboarding@resend.dev while testing
RESEND_API_KEY=<re_...>
MAIL_FROM=orders@your-domain.com
OWNER_EMAIL=owner@gmail.com

# PayPal REST app credentials (https://developer.paypal.com/dashboard/applications)
# Webhook: subscribe to INVOICING.INVOICE.PAID, point it at https://<public-url>/paypal/webhook
PAYPAL_CLIENT_ID=<client-id>
PAYPAL_CLIENT_SECRET=<client-secret>
PAYPAL_WEBHOOK_ID=<webhook-id>
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=EUR

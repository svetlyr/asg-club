---
import { credits, site } from "../data/site";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer>
	<div class="main">
		<div class="brand">
			<Logo small />
			<div class="name">{site.brand}</div>
		</div>
		<div class="contacts">
			<a href={`mailto:${site.email}`}>{site.email}</a>
			<span>{site.phone}</span>
			<span>{site.hours}</span>
		</div>
		<div class="copy">© {year} {site.brand}</div>
	</div>
	<div class="credits">
		<div class="cinner">
			Made with <span class="heart">❤</span> by{' '}
			{
				credits.map((c, i) => (
					<>
						<a href={c.url} target="_blank" rel="noopener">
							{c.name}
						</a>
						{i < credits.length - 1 && ' and '}
					</>
				))
			}
			{` ${year}`}
		</div>
	</div>
</footer>

<style>
footer {
	border-top: 1px solid var(--line);
}

.main {
	max-width: 1200px;
	margin: 0 auto;
	padding: 42px 24px 14px;
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	justify-content: space-between;
	gap: 20px;

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;

		.name {
			font-weight: 800;
			font-size: 15px;
			letter-spacing: 0.4px;
		}
	}

	.contacts {
		display: flex;
		flex-wrap: wrap;
		gap: 26px;
		font-family: var(--font-mono);
		font-size: 12.5px;
		letter-spacing: 0.5px;
		color: var(--muted);

		a {
			color: var(--muted);
			text-decoration: none;
			transition: color 0.15s;

			&:hover {
				color: var(--text);
			}
		}
	}

	.copy {
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 1px;
		color: color-mix(in srgb, var(--muted) 80%, transparent);
	}
}

.credits {
	.cinner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0px 24px 40px 24px;
		text-align: center;
		font-family: var(--font-mono);
		font-size: 12.5px;
		letter-spacing: 0.5px;
		color: var(--muted);

		a {
			color: var(--accent);
			text-decoration: none;
			font-weight: 600;
			transition: color 0.15s;

			&:hover {
				color: var(--accent-hover);
				text-decoration: underline;
			}
		}

		.heart {
			color: var(--danger);
		}
	}
}
</style>

---
import { products } from "../data/site";
---

<section id="products" class="sec">
	<div class="head">
		<div>
			<div class="kicker">01 / SELECT YOUR PRODUCT</div>
			<h2>Choose what you<br />want made</h2>
		</div>
		<p class="side">
			Pick a category to highlight it — your choice carries straight into the order form below.
		</p>
	</div>

	<div class="grid">
		{
			products.map((p, i) => (
				<label class="card">
					<input type="radio" name="product" value={p.id} form="order-form" />
					<span class="ring" />
					<span class="badge">✓</span>
					<span class="top">
						<span class="icon">
							<svg
								width="30"
								height="30"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								{p.paths.map((d) => (
									<path d={d} />
								))}
							</svg>
						</span>
						<span class="num">{String(i + 1).padStart(2, '0')}</span>
					</span>
					<span class="meta">
						<span class="name">{p.name}</span>
						<span class="desc">{p.desc}</span>
					</span>
				</label>
			))
		}
	</div>
</section>

<style>
.sec {
	max-width: 1200px;
	margin: 0 auto;
	padding: 96px 24px;

	@media (max-width: 760px) {
		padding-top: 64px;
		padding-bottom: 64px;
	}
}

.head {
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	flex-wrap: wrap;
	gap: 16px;
	margin-bottom: 42px;

	.kicker {
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 3px;
		color: var(--accent);
		margin-bottom: 14px;
	}

	h2 {
		margin: 0;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: -0.5px;
		font-size: clamp(28px, 4vw, 42px);
		line-height: 1;
	}

	.side {
		margin: 0;
		max-width: 36ch;
		font-size: 15px;
		line-height: 1.55;
		color: var(--muted);
	}
}

.grid {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(248px, 1fr));
	gap: 14px;
}

.card {
	position: relative;
	text-align: left;
	cursor: pointer;
	background: var(--bg-secondary);
	border: 1px solid var(--line);
	border-radius: 4px;
	padding: 24px 22px 22px;
	min-height: 188px;
	display: flex;
	flex-direction: column;
	transition:
		transform 0.15s ease,
		border-color 0.15s ease,
		background 0.15s ease;
	color: var(--text);

	&:hover {
		border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
		transform: translateY(-3px);
		background: var(--bg-tertiary);
	}

	input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	&:has(input:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.ring {
		position: absolute;
		inset: 0;
		border-radius: 4px;
		pointer-events: none;
		border: 1.5px solid transparent;
		transition:
			border-color 0.15s,
			background 0.15s;
	}

	.badge {
		position: absolute;
		top: 12px;
		right: 12px;
		width: 22px;
		height: 22px;
		border-radius: 3px;
		background: var(--accent);
		color: var(--on-accent);
		font-size: 13px;
		font-weight: 800;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transform: scale(0.6);
		transition:
			opacity 0.15s,
			transform 0.15s;
	}

	.top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;

		.icon {
			color: var(--accent);
		}

		.num {
			font-family: var(--font-mono);
			font-size: 12px;
			color: var(--muted);
			transition: opacity 0.12s;
		}
	}

	.meta {
		display: block;
		margin-top: auto;
		padding-top: 26px;

		.name {
			display: block;
			font-weight: 700;
			font-size: 17px;
			letter-spacing: 0.2px;
			text-transform: uppercase;
			line-height: 1.1;
		}

		.desc {
			display: block;
			margin-top: 7px;
			font-size: 13px;
			color: var(--muted);
			line-height: 1.45;
		}
	}

	&:has(input:checked) {
		.ring {
			border-color: var(--accent);
			background: color-mix(in srgb, var(--accent) 8%, transparent);
		}

		.badge {
			opacity: 1;
			transform: scale(1);
		}

		.num {
			opacity: 0;
		}
	}
}
</style>

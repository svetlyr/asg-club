{
    "name": "asg-club",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev:frontend": "bun run --filter=frontend dev",
        "dev:server": "bun run --filter=server dev",
        "check": "biome check .",
        "fix": "biome check --write .",
        "typecheck": "bun run --filter='*' typecheck",
        "up": "bun update --latest"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.4",
        "typescript": "^7.0.2"
    },
    "trustedDependencies": [
        "@biomejs/biome",
        "esbuild",
        "sharp"
    ]
}
